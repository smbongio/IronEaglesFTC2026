<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <!-- Motor port 0: front right drive motor. -->
            <Motor type="UnspecifiedMotor" name="chPort0" port="0" />
            <!-- Motor port 1: back right drive motor. -->
            <Motor type="UnspecifiedMotor" name="chPort1" port="1" />
            <!-- Motor port 2: back left drive motor. -->
            <Motor type="UnspecifiedMotor" name="chPort2" port="2" />
            <!-- Motor port 3: front left drive motor. -->
            <Motor type="UnspecifiedMotor" name="chPort3" port="3" />
            <!-- Servo port 0: REV Blinkin LED Driver. -->
            <RevBlinkinLedDriver name="chServo0" port="0" />
        </LynxModule>
        <LynxModule name="Expansion Hub 2" port="2">
            <!-- Motor port 0: intake motor (power only). Encoder jack: RIGHT odometry pod (front-to-back). -->
            <Motor type="UnspecifiedMotor" name="ehPort0" port="0" />
            <!-- Motor port 1: no motor. Encoder jack: LEFT odometry pod (front-to-back). -->
            <Motor type="UnspecifiedMotor" name="ehPort1" port="1" />
            <!-- Motor port 2: shooter motor. Encoder jack: shooter motor's encoder (speed control). -->
            <Motor type="UnspecifiedMotor" name="ehPort2" port="2" />
            <!-- Motor port 3: no motor. Encoder jack: X wheel = REAR odometry pod (side-to-side). -->
            <Motor type="UnspecifiedMotor" name="ehPort3" port="3" />
            <!-- Servo port 0: hopper, REV Smart Servo programmed to continuous mode. -->
            <ContinuousRotationServo name="ehServo0" port="0" />
        </LynxModule>
    </LynxUsbDevice>
    <Webcam name="camera" serialNumber="4B75BEAF" />
</Robot>
