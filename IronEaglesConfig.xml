<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <Motor type="UnspecifiedMotor" name="frontRight" port="0" />
            <!-- Drive motor. Encoder jack is the back (side-to-side) odometry pod. -->
            <Motor type="UnspecifiedMotor" name="backRight" port="1" />
            <Motor type="UnspecifiedMotor" name="backLeft" port="2" />
            <Motor type="UnspecifiedMotor" name="frontLeft" port="3" />
            <!-- REV Blinkin LED Driver on servo/PWM port 0. Hardware map name is "blinkin". -->
            <RevBlinkinLedDriver name="blinkin" port="0" />
        </LynxModule>
        <LynxModule name="Expansion Hub 2" port="2">
            <!-- Intake motor, open-loop power only. Encoder jack is the left (front-to-back) odometry pod, not an intake encoder. -->
            <Motor type="UnspecifiedMotor" name="intake" port="0" />
            <Motor type="UnspecifiedMotor" name="hopper" port="1" />
            <!-- No motor. Encoder jack is the right (front-to-back) odometry pod. -->
            <Motor type="UnspecifiedMotor" name="rightPod" port="2" />
            <!-- Shooter motor. Encoder jack is the shooter's own encoder. -->
            <Motor type="UnspecifiedMotor" name="shooter" port="3" />
        </LynxModule>
    </LynxUsbDevice>
    <Webcam name="camera" serialNumber="4B75BEAF" />
</Robot>
